# Copie para .env (nao versionado) e preencha.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# OpenAI: destrava o multi-provedor de IA (docs/05-multi-provedor-ia.md) e a
# geracao/edicao de imagem de prato (docs/06-geracao-imagem-ia.md).
OPENAI_API_KEY=
DB_URL=jdbc:postgresql://localhost:5432/restoria
DB_USERNAME=restoria
DB_PASSWORD=restoria
# Segredo usado para assinar/validar tokens JWT (RF-05). Precisa ter pelo
# menos 32 caracteres (256 bits) para o algoritmo HS256.
JWT_SECRET=

# Cobranca (SaaS): checkout + webhook do Stripe (com.restoria.assinatura).
# STRIPE_PRICE_ID_PRO e o id do Price recorrente do plano PRO (criado no
# dashboard do Stripe) — valor decidido: R$ 49,90/mes (ver docs/00-visao-geral.md).
# STRIPE_SUCCESS_URL/STRIPE_CANCEL_URL tem default pra
# localhost:4200 (ver application.yml) e so precisam ser setadas em producao.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Verificacao de e-mail no cadastro (opcional por enquanto — sem essas
# variaveis, EMAIL_MOCK fica true por padrao e o link de verificacao so e
# logado, nao enviado de verdade). MAIL_HOST/USERNAME/PASSWORD sao as
# credenciais SMTP (funciona com qualquer provedor: Gmail com senha de app,
# Resend, SendGrid via SMTP relay, etc.) — nunca versionadas.
EMAIL_MOCK=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_REMETENTE=
FRONTEND_URL=
